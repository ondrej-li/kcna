# /etc/systemd/system/kcna-autodeploy.timer
# Installed and enabled by deploy/deploy.sh.
[Unit]
Description=kcna.ondralinek.cz — check GitHub every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=20s
AccuracySec=30s
Persistent=true
Unit=kcna-autodeploy.service

[Install]
WantedBy=timers.target
