# /etc/systemd/system/kcna-autodeploy.service
# Installed by deploy/deploy.sh; enabled by kcna-autodeploy.timer.
[Unit]
Description=kcna.ondralinek.cz — pull new articles, rebuild and publish
Documentation=https://github.com/ondrej-li/kcna/blob/main/deploy/DEPLOY.md
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/home/deploy/kcna/.git

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/kcna
Environment=MAIL_TO=ondrej.linek@gmail.com
ExecStart=/home/deploy/kcna/deploy/autodeploy.sh
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle

# deploy.sh needs sudo to rsync into /var/www/kcna, install the vhost and
# reload nginx, so filesystem sandboxing would block the legitimate work.
# The unit still runs as the unprivileged deploy user with a short timeout.
PrivateTmp=yes
NoNewPrivileges=no
