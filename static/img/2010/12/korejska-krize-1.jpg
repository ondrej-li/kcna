					<span class="tit01">{{ DESCRIPTION }}</span>
					<a href="{{ URL }}" class="btn-type216 arr01{{URL_STYLE}}">
						<span class="txt01">{{ URL_TITLE }}</span>
					</a>
				</div>
				<figure class="img-con01">
					<div class="img">
						<img src="{{ IMAGE }}" alt="{{ IMAGE_ALT }}" loading="lazy">
					</div>
				</figure>
			</div>
			<button type="button" class="btn-type039{{CLOSE_BUTTON_STYLE}}" title="닫기">
				<span class="ir-txt01">닫기</span>
			</button>
		</div>
	</div>
</script>
<script id="campaignBenefitPopup01_Template" type="text/x-handlebars-template">
	<div class="popup-type54 pop-campaign">
		<div class="pop-wrap">
			<div class="pop-header">
				<strong class="tit01">{{ TITLE }}</strong>
				<button type="button" class="btn-type004 close01" data-pop-close="pop-campaign">
					<span class="ir-txt01">닫기</span>
				</button>
			</div>
			<div class="pop-content">
				<figure class="img-con01">
					<span class="img">
						<img src="{{ IMAGE }}" alt="{{ IMAGE_ALT }}" loading="lazy">
					</span>
				</figure>
				<p class="tit01">{{ SUB_TITLE }}</p>
				<span class="txt-type003 style01">
					{{ DESCRIPTION }}
				</span>
				<span class="txt-time">{{ PERIOD }}</span>
			</div>
			<div class="btns-wrap03">
				<a href="{{ URL }}" class="btn-type304 style01">
					<span class="txt01">{{ URL_TITLE }}</span>
				</a>
				<button type="button" class="btn-type201"><span class="txt01">다시 보지 않기</span></button>
			</div>
		</div>
	</div>
</script>
